# ==============================================================================
# 2. LINE MESSAGING API & LIFF (สำหรับระบบแจ้งเตือนและแอป LINE)
# ==============================================================================
# LINE Front-end Framework ID (หาได้จาก LINE Developers Console > LIFF tab)
# ใช้สำหรับหน้าลูกค้า, พนักงาน, ชำระเงิน (/payment), และรีวิว (/review)
NEXT_PUBLIC_LIFF_ID=your-line-liff-id-here

# LINE Messaging API Channel Access Token (Long-lived token)
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token-here

# LINE Messaging API Channel Secret
LINE_CHANNEL_SECRET=your-line-channel-secret-here


# ==============================================================================
# 3. GOOGLE CALENDAR API (สำหรับการซิงค์นัดหมายลง Google Calendar)
# ==============================================================================
# Google Service Account Email จาก Google Cloud Console
GOOGLE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com

# Google Service Account Private Key (รวมบรรทัด BEGIN / END PRIVATE KEY และต้องมีเครื่องหมายคำพูดครอบ)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"


# ==============================================================================
# 4. TELEGRAM BOT (สำหรับแจ้งเตือนแอดมินผ่าน Telegram)
# ==============================================================================
# Token บอท Telegram (ได้จาก @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Chat ID ของแอดมินหรือกลุ่มที่จะรับข้อความ (ดูได้จาก @userinfobot หรือ @RawDataBot)
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id-here


# ==============================================================================
# 5. API SECURITY & CRON SECRETS (สำหรับป้องกัน API Route และ Cron Job)
# ==============================================================================
# Secret Key สำหรับเรียก Internal API (/api/line-connect, /api/send-line-message)
INTERNAL_API_SECRET=your-secure-internal-api-secret

# Secret Key สำหรับเรียก Cron Job (/api/cron/send-reminders, /api/cron/send-daily-notifications)
CRON_SECRET=your-secure-cron-secret


# ==============================================================================
# 6. DEVELOPMENT SETTINGS (เฉพาะช่วงพัฒนา Local)
# ==============================================================================
# ตั้งเป็น true เพื่อ bypass ตรวจสอบ Admin Auth ตอนรันในเครื่อง (NODE_ENV !== 'production')
ALLOW_DEV_AUTH_BYPASS=false
